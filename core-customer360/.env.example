# =============================================================================
# Customer 360 Platform - consolidated configuration
#
# Copy this file to `.env` (same directory as docker-compose.yml) and adjust
# values for your environment. `.env` is gitignored and is used TWO ways by
# docker-compose.yml:
#   1. ${VAR} substitution inside docker-compose.yml itself (e.g. seeding the
#      official postgres/redis images' bootstrap env vars).
#   2. Passed into every container via `env_file:` so customer360-api and
#      identity-resolution-service (CIR) read it exactly like they do for
#      non-Docker local dev (pydantic-settings / python-dotenv).
#
# NOTE: DB_HOST / REDIS_HOST below are irrelevant *inside* docker-compose --
# docker-compose.yml always overrides them to the in-network service names
# (`postgres` / `redis`) for the api/cir/cir-demo-seed containers. They only
# matter if you run customer360-api or identity-resolution-service directly
# on the host (./start.sh, ./run-demo.sh) against the dockerized Postgres/
# Redis (in which case `localhost` + the published host ports is correct).
# =============================================================================

# ----- PostgreSQL --------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me_postgres_password
DB_NAME=customer360
DB_SCHEMA=customer360

# Optional: change the host-published Postgres port (container always listens
# on 5432 internally).
POSTGRES_HOST_PORT=5432
# Bind address for the published Postgres port. Defaults to loopback-only;
# set to 0.0.0.0 to expose it on the network (not recommended in production).
POSTGRES_HOST_BIND=127.0.0.1

# ----- Redis (customer360-api response cache) -----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me_redis_password

# Optional: change the host-published Redis port.
REDIS_HOST_PORT=6379
# Bind address for the published Redis port. Defaults to loopback-only; set
# to 0.0.0.0 to expose it on the network (not recommended in production).
REDIS_HOST_BIND=127.0.0.1

# Toggle the whole caching layer on/off + default TTL for cached responses.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# ----- customer360-api: SQLAlchemy connection pool -------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
DB_ECHO_SQL=false

# ----- customer360-api: FastAPI / uvicorn ----------------------------------
API_DEFAULT_PAGE_SIZE=100
API_MAX_PAGE_SIZE=1000
API_HOST=0.0.0.0
API_PORT=8000
UVICORN_RELOAD=false

# Optional: change the host-published API port.
API_HOST_PORT=8000
# Bind address for the published API port. Defaults to loopback-only; put a
# reverse proxy in front and/or set to 0.0.0.0 for production ingress.
API_HOST_BIND=127.0.0.1

# ----- frontend-admin: FastAPI static site + uvicorn -----------------------
# Hostname/port the BROWSER uses to reach customer360-api. Baked into
# static/js/config.js (window.C360.config defaults) via Jinja2 at request
# time -- see frontend-admin/app.py. Must be reachable from the browser, so
# a docker-network service name (e.g. http://api:8000) will NOT work here;
# use the published host/port above, or a public reverse-proxy hostname.
FRONTEND_API_HOSTNAME=http://localhost:8000
FRONTEND_TENANT_ID=11111111-1111-1111-1111-111111111111
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8890
FRONTEND_UVICORN_RELOAD=false

# Optional: change the host-published frontend-admin port.
FRONTEND_HOST_PORT=8890
# Bind address for the published frontend-admin port. Defaults to
# loopback-only; set to 0.0.0.0 (or front with a reverse proxy) for
# production ingress.
FRONTEND_HOST_BIND=127.0.0.1

# ----- identity-resolution-service (CIR) -----------------------------------
CIR_BATCH_SIZE=5000
# How often (seconds) the containerized CIR worker polls for new/unresolved
# raw profiles. Only used by identity-resolution-service/worker.py.
CIR_POLL_INTERVAL_SECONDS=30

# ----- customer360-api: Keycloak SSO / API security ------------------------
# See core-customer360/customer360-api/core/auth.py + core/config.py.
# All customer360-api endpoints EXCEPT /health require a valid Keycloak
# access token ("Authorization: Bearer <token>"). Tokens are verified via
# Keycloak's token introspection endpoint, then cached in Redis
# (auth:token:<token>, TTL = token exp) so repeat requests don't re-hit
# Keycloak on every call.
#
# SSO_LOGIN_URL: base URL of the Keycloak server.
#   - Running customer360-api directly on the host (./start.sh): use
#     http://localhost:${KEYCLOAK_HOST_PORT:-8080} (the published port below).
#   - docker-compose.yml overrides this to http://keycloak:8080 for the `api`
#     container automatically (in-network service name), same pattern as
#     DB_HOST/REDIS_HOST.
#
# Multi-tenant Row-Level Security (RLS): every crm_*/cdp_* table has a
# tenant_policy RLS policy keyed on the Postgres session variable
# app.tenant_id (see the "ROW LEVEL SECURITY" section of database-schema.sql).
# When SSO_LOGIN=true, tenant_id/user_id are resolved from the verified
# Keycloak token (custom claims, or a sys_user.keycloak_user_id lookup -- see
# core/auth.py::_resolve_tenant_and_user). When SSO_LOGIN=false (local/dev
# only), pass `X-Tenant-Id`/`X-User-Id` headers explicitly on each request --
# without one of these, RLS fails closed (queries return zero rows).
SSO_LOGIN=true
SSO_LOGIN_URL=http://localhost:8080
KEYCLOAK_REALM=leocdp
KEYCLOAK_CLIENT_ID=leocdp
KEYCLOAK_CLIENT_SECRET=change_me_keycloak_client_secret
KEYCLOAK_CALLBACK_URL=http://localhost:8000/auth/callback
KEYCLOAK_VERIFY_SSL=false

# ----- Local dev Keycloak container (docker-compose `keycloak` service) ----
# Uses the SAME PostgreSQL instance as customer360-api, but a dedicated
# database (db_keycloak), auto-created by the `keycloak-db-init` one-shot
# service before Keycloak starts (see postgres/init/02-create-keycloak-db.sql).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password
# Optional: change the host-published Keycloak port.
KEYCLOAK_HOST_PORT=8080
# Bind address for the published Keycloak port. Defaults to loopback-only;
# set to 0.0.0.0 (or front with a reverse proxy) for production ingress.
KEYCLOAK_HOST_BIND=127.0.0.1
# Pin the Keycloak image tag (avoid `:latest` -- see docker-compose.yml).
KEYCLOAK_VERSION=26.7
# `start-dev` for local/testing SSO. In real production, behind TLS, use
# `start` and configure KC_HOSTNAME/KC_PROXY_HEADERS accordingly.
KEYCLOAK_COMMAND=start-dev
# Public hostname Keycloak advertises in issued tokens/URLs.
KEYCLOAK_HOSTNAME=localhost

# ----- GEN-AI configuration ----
GOOGLE_GENAI_API_KEY=YOUR_GOOGLE_GENAI_API_KEY
GOOGLE_GENAI_MODEL=gemini-3.5-flash-lite
