# Generated by Terraform — do NOT edit by hand.
# Consumed two ways on the VM:
#   1. copied to core-customer360/.env  -> injected into api/cir containers
#      (env_file) and used for docker compose variable interpolation.
#   2. sourced by bootstrap.sh for the one-time managed-DB schema load.

# ----- PostgreSQL (VNG Cloud managed vDB / RDS) -----
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_USER=${db_user}
DB_PASSWORD=${db_pass}
DB_NAME=${db_name}
DB_SCHEMA=customer360

# ----- Redis (VNG Cloud managed vDB / MemoryStore) -----
REDIS_HOST=${redis_host}
REDIS_PORT=${redis_port}
REDIS_DB=0
REDIS_PASSWORD=${redis_pass}
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# ----- customer360-api: SQLAlchemy pool -----
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
DB_ECHO_SQL=false

# ----- customer360-api: FastAPI / uvicorn -----
API_DEFAULT_PAGE_SIZE=100
API_MAX_PAGE_SIZE=1000
API_HOST=0.0.0.0
API_PORT=8000
UVICORN_RELOAD=false

# ----- identity-resolution-service (CIR) -----
CIR_BATCH_SIZE=5000
CIR_POLL_INTERVAL_SECONDS=30

# ----- Keycloak SSO / API security -----
# NOTE: docker-compose.cloud.yml overrides SSO_LOGIN_URL to http://keycloak:8080
# for the api container (in-network service name).
SSO_LOGIN=true
SSO_LOGIN_URL=http://localhost:8080
KEYCLOAK_REALM=${keycloak_realm}
KEYCLOAK_CLIENT_ID=${keycloak_client_id}
KEYCLOAK_CLIENT_SECRET=${keycloak_client_secret}
KEYCLOAK_CALLBACK_URL=${keycloak_callback_url}
KEYCLOAK_VERIFY_SSL=false
KEYCLOAK_ADMIN=${keycloak_admin}
KEYCLOAK_ADMIN_PASSWORD=${keycloak_admin_password}
KEYCLOAK_VERSION=${keycloak_version}
KEYCLOAK_COMMAND=${keycloak_command}
KEYCLOAK_HOSTNAME=${keycloak_hostname}

GOOGLE_GENAI_API_KEY=${google_genai_api_key}

# ----- bootstrap.sh only (not application config) -----
APP_REPO_URL=${app_repo_url}
APP_REPO_REF=${app_repo_ref}
